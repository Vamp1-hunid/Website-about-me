# Copy this file to ".env" for running the site on your laptop.
# On Render, add the same names under the service's "Environment" tab instead.
# Never commit the real .env file: it is listed in .gitignore.

# Neon connection string (Neon dashboard -> Connect). Starts with postgresql://
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random value that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Your admin login. The account is created the first time the server starts.
# Use a strong password of at least 10 characters.
ADMIN_USERNAME=mwamba
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Mulenga Mwamba

# Cloudinary "API environment variable" (Cloudinary dashboard). Starts with cloudinary://
# Leave empty on your laptop to save uploads in public/uploads/ instead.
CLOUDINARY_URL=

# Set to "production" on Render.
NODE_ENV=development
