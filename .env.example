# Copy this file to ".env" for running the site on your laptop.
# On Render, add the same names under the service's "Environment" tab instead.
# Never commit the real .env file: it is listed in .gitignore.

# Neon connection string (Neon dashboard -> Connect). Starts with postgresql://
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# A long random value that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Your admin login. The account is created the first time the server starts.
# Use a strong password of at least 10 characters.
ADMIN_USERNAME=mwamba
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Mulenga Mwamba

# Cloudinary "API environment variable" (Cloudinary dashboard). Starts with cloudinary://
# Leave empty on your laptop to save uploads in public/uploads/ instead.
CLOUDINARY_URL=

# Set to "production" on Render.
NODE_ENV=development

# ----- Email (optional): switches on "Forgot password" and emails contact-form messages to you -----
# Use ONE provider. Brevo (brevo.com) is free for 300 emails a day and only needs a verified sender
# address (Brevo -> Senders & IP -> Senders -> add your Gmail and click the link it emails you).
BREVO_API_KEY=
# RESEND_API_KEY=
# The sender people see. With Brevo it must be the address you verified.
MAIL_FROM=God's Banditos <yourname@gmail.com>
# Where contact-form messages are delivered (usually your own inbox).
CONTACT_EMAIL=
